import { readFileSync } from 'node:fs'
import { resolve } from 'node:path'
import { pathToFileURL } from 'node:url'
import { numberPuzzleDifficulties } from '../src/number-puzzles/catalog.ts'
import { seededIndex } from '../src/number-puzzles/generation-random.ts'
import { findKakuroRecipes, kakuroLayouts } from '../src/kakuro/generator.ts'

export { kakuroRecipeSignature } from '../src/kakuro/generator.ts'

function generateCatalog() {
  const pick = seededIndex(0x19341c64)
  const puzzlesPerLayout = 2
  const signatures = new Set<string>()
  const lines = [
    '// Generated by scripts/generate-kakuro-catalog.mts. Keep published recipes in order.',
    'export const generatedKakuroRecipes = {',
  ]
  for (const difficulty of numberPuzzleDifficulties) {
    lines.push(`  ${difficulty}: [`)
    const byLayout = kakuroLayouts[difficulty].map(rows => {
      const recipes = findKakuroRecipes(rows, difficulty, signatures, pick, puzzlesPerLayout)
      if (recipes.length !== puzzlesPerLayout) throw new Error(`Could not fill the ${difficulty} Kakuro catalog.`)
      return recipes
    })
    for (let puzzle = 0; puzzle < puzzlesPerLayout; puzzle++) {
      for (const recipes of byLayout) {
        const [width, clues] = recipes[puzzle]
        lines.push(`    [${width}, '${clues}'],`)
      }
    }
    lines.push('  ],')
  }
  lines.push('} as const', '')
  return lines.join('\n')
}

if (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {
  const args = process.argv.slice(2)
  if (args.length && (args.length !== 1 || args[0] !== '--check')) {
    throw new Error('Use --check to compare the catalog without changing it.')
  }
  const catalog = generateCatalog()
  const file = new URL('../src/kakuro/generated-recipes.ts', import.meta.url)
  if (args[0] === '--check') {
    if (readFileSync(file, 'utf8') !== catalog) throw new Error('The Kakuro catalog differs from the generated recipes.')
  } else {
    process.stdout.write(catalog)
  }
}
